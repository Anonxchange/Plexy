{%- comment -%}
  Pexly redirect: send storefront traffic to the external Pexly site.
  - Product pages           -> https://www.pexly.app/shop/product/{handle}
  - Account/login pages     -> https://www.pexly.app/signin
  - Everything else         -> https://www.pexly.app/shop
  Checkout is never affected because Shopify's checkout does not render
  through this theme layout.
{%- endcomment -%}
<script>
  (function () {
    var pageType = {{ request.page_type | json }};
    var destination;

    {% if template contains 'product' and product %}
      destination = 'https://www.pexly.app/shop/product/{{ product.handle }}';
    {% else %}
      destination = pageType && pageType.indexOf('customers') === 0
        ? 'https://www.pexly.app/signin'
        : 'https://www.pexly.app/shop';
    {% endif %}

    window.location.replace(destination);
  })();
</script>
