{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "workspaces": [
    "artifacts/*",
    "vendor/*"
  ],
  "scripts": {
    "dev": "pnpm --filter @workspace/pexo dev",
    "build": "pnpm --filter @workspace/pexo typecheck && pnpm --filter @workspace/pexo build",
    "typecheck": "pnpm --filter @workspace/pexo typecheck",
    "lint": "pnpm --filter @workspace/pexo typecheck",
    "preview": "pnpm --filter @workspace/pexo serve"
  },
  "overrides": {
    "bigint-buffer": "file:./vendor/bigint-buffer",
    "esbuild": "0.28.2"
  },
  "private": true,
  "devDependencies": {
    "prettier": "^3.9.10",
    "typescript": "~5.9.3"
  }
}
